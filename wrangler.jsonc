{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "actors-prompter",
  "main": "./worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/kokoro/*"],
    "not_found_handling": "single-page-application"
  }
}
